{
  "version": "2.0.0",
  "tasks": [
    {
        "label": "Build (UTF-8)",
        "type": "shell",
        "group": { "kind": "build", "isDefault": true },
        "command": "powershell",
        "args": [
            "-NoProfile",
            "-Command",
            "chcp 65001; $env:MSBUILDENABLEUTF8OUTPUT = '1'; cmake --build build --config Debug"
        ],
        "options": {
            "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
    },
    {
        "type": "cmake",
        "label": "CMake: build",
        "command": "build",
        "targets": [
            "ALL_BUILD"
        ],
        "group": "build",
        "problemMatcher": [],
        "detail": "CMake template build task"
    }
]
}