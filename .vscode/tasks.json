{
  "version": "2.0.0",
  "tasks": [
    {
        "label": "Build (UTF-8)",
        "type": "shell",
        "group": { "kind": "build", "isDefault": true },
        "command": "powershell",
        "args": [
            "-NoProfile",
            "-Command",
            "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; chcp 65001 > $null; $env:MSBUILDENABLEUTF8OUTPUT='1'; cmake --build build --config Debug"
        ],
        "options": {
            "cwd": "${workspaceFolder}"
        },
        "presentation": {
            "echo": true,
            "reveal": "always",
            "panel": "shared",
            "showReuseMessage": false
        },
        "problemMatcher": []
    },
    {
        "type": "cmake",
        "label": "CMake: build",
        "command": "build",
        "targets": [
            "ALL_BUILD"
        ],
        "group": "build",
        "problemMatcher": [],
        "detail": "CMake template build task"
    }
]
}